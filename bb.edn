{:deps {zprint/zprint {:mvn/version "1.2.9"}}
 :tasks
 {:requires ([babashka.fs :as fs]
             [babashka.process :refer [shell]]
             [clojure.string :as str])
  :init (do (defn sh [& args]
              (apply shell {:dir "." :out :inherit :err :inherit} args))
            (defn msg [emoji & parts] 
              (println emoji (str/join " " parts))))

  build:gen {:doc "Generate Svelte components from ClojureScript DSL"
             :task (do (msg "🎊" "Generating living ecosystem components...")
                       (shell {:dir "site-dsl"} "npm" "ci")
                       (shell {:dir "site-dsl"} "npx" "shadow-cljs" "compile" "node-script")
                       (shell {:dir "site-dsl"} "node" "target/main.js")
                       (msg "🖤" "ClojureScript DSL → Svelte generation complete"))}

  build:bundle {:doc "Bundle SvelteKit with warm themes"
                :task (do (msg "🤎" "Bundling SvelteKit with warm theming...")
                          (shell {:dir "web"} "npm" "ci")
                          (shell {:dir "web"} "npm" "run" "build")
                          (msg "💙" "SvelteKit bundling complete"))}

  build:site {:doc "Complete site build with living ecosystem features"
              :depends [build:gen build:bundle]
              :task (msg "🌱" "Living ecosystem site build complete!")}

  lint:kondo {:doc "Static analysis with clj-kondo"
              :task (do (msg "🔍" "Linting with clj-kondo...")
                        (sh "clj-kondo" "--version")
                        (sh "clj-kondo" "--lint" "site-dsl/src" "scripts" "config")
                        (msg "✅" "Static analysis complete"))}

  fmt:write {:doc "Format all Clojure files to 80 columns"
             :task (do (msg "📐" "Formatting to 80 columns...")
                       (sh "find" "." "-name" "*.clj" "-exec" "zprint" "--write" "{}" "\\;")
                       (sh "find" "." "-name" "*.cljs" "-exec" "zprint" "--write" "{}" "\\;")
                       (sh "find" "." "-name" "*.edn" "-exec" "zprint" "--write" "{}" "\\;")
                       (msg "✅" "80-column formatting complete"))}

  fmt:check {:doc "Check formatting without writing changes"
             :task (do (msg "🔎" "Checking 80-column formatting...")
                       (msg "💡" "Use fmt:write to enforce formatting"))}

  clean {:doc "Clean build artifacts"
         :task (do (fs/delete-tree "web/build" {:force true})
                   (fs/delete-tree "web/dist" {:force true})
                   (msg "🧹" "Build artifacts cleaned"))}

  clean:deep {:doc "Deep clean for CI disk pressure relief"
              :task (do (fs/delete-tree "web/build" {:force true})
                        (fs/delete-tree "web/dist" {:force true})
                        (fs/delete-tree "web/node_modules" {:force true})
                        (fs/delete-tree "site-dsl/node_modules" {:force true})
                        (fs/delete-tree "site-dsl/.shadow-cljs" {:force true})
                        (fs/delete-tree "target" {:force true})
                        (fs/delete-tree ".shadow-cljs" {:force true})
                        (msg "🎊" "Deep clean complete - CI disk pressure relief! 🖤"))}

  ;; Enhanced clj-kondo integration tasks
  quality:check {:doc "Run all quality checks (lint + format)"
                 :depends [lint:kondo fmt:check]
                 :task (msg "🎯" "All quality checks passed!")}

  clj-kondo:config {:doc "Generate clj-kondo configuration"
                    :task (do (msg "⚙️" "Setting up clj-kondo config...")
                              (spit ".clj-kondo/config.edn"
                                    "{:config-paths [\"config\"]
                                      :lint-as {clojure.core.async/go-loop clojure.core.async/go}
                                      :linters {:unused-namespace {:level :warning}
                                                :unused-var {:level :warning}
                                                :unresolved-symbol {:level :error}}
                                      :clj-kondo/ignore-for-ns {site.parser [unresolved-symbol]}
                                      :output {:format :edn :analysis true}}")
                              (msg "✅" "clj-kondo config generated"))}

  clj-kondo:analysis {:doc "Export clj-kondo analysis data"
                      :task (do (msg "📊" "Exporting clj-kondo analysis...")
                                (sh "clj-kondo" "--lint" "site-dsl/src" "scripts" "config" "--config" ".clj-kondo/config.edn" "--export" "clj-kondo-analysis.edn")
                                (msg "✅" "Analysis data exported to clj-kondo-analysis.edn"))}

  build:all {:doc "Complete functional build pipeline"
             :depends [build:site lint:kondo fmt:check]
             :task (msg "🌽" "Functional farm build pipeline complete!")}
  
  dev {:doc "Development mode with live reload"
       :task (do (msg "🎊" "Starting development mode...")
                 (future (shell {:dir "."} "bb" "build:gen"))
                 (Thread/sleep 2000)
                 (msg "🖤" "Live reload enabled - edit docs/ for updates"))}
  
  status {:doc "Show system status and health"
          :task (do (msg "🎊" "NixtaVeganic Functional Farm System Status")
                    (println "📁 Repository:" (System/getProperty "user.dir"))
                    (println "🔧 Babashka:" (System/getProperty "babashka.version"))
                    (println "📄 Documentation files:" (count (fs/glob "docs" "*.md")))
                    (println "🎨 Generated components:" (count (fs/glob "web/src/lib/generated" "*.svelte")))
                    (println "🌐 Local server: http://localhost:8080")
                    (println "🖤🤎💙 Philosophy: Simple made easy, farms made functional"))}
  
  serve {:doc "Start Babashka HTTP server for local development"
         :task (do (when-not (fs/exists? "web/dist/index.html")
                     (msg "⚠️" "No built site found - run 'bb build:all' first"))
                   (msg "🎊" "Starting Babashka HTTP server...")
                   (load-file "scripts/serve.clj")
                   ((resolve 'serve/start-server)))}
  
  health {:doc "Run comprehensive system health checks"
          :task (do (load-file "scripts/health-check.clj")
                    ((resolve 'health-check/run-health-checks)))}}}